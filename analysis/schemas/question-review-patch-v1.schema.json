{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electroscholar.dev/schemas/question-review-patch-v1.schema.json",
  "title": "ElectroScholar Question Review Patch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "document_id",
    "base_document_sha256",
    "source_asset_sha256",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "question-review-patch/v1"
    },
    "patch_id": {
      "type": "string",
      "pattern": "^question-review-patch:[a-f0-9]{24}$"
    },
    "document_id": {
      "$ref": "#/$defs/id"
    },
    "base_document_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_asset_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_event_id",
        "target_ref",
        "reviewer",
        "decision",
        "comment",
        "original_value",
        "submitted_value",
        "original_plain_text",
        "submitted_plain_text",
        "created_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source_event_id": {
          "type": "integer",
          "minimum": 1
        },
        "target_ref": {
          "$ref": "#/$defs/id"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": ["accept", "correct", "reject", "defer"]
        },
        "comment": {
          "type": "string"
        },
        "original_value": {
          "type": "string"
        },
        "submitted_value": {
          "type": "string"
        },
        "original_plain_text": {
          "type": ["string", "null"]
        },
        "submitted_plain_text": {
          "type": ["string", "null"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
