{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "version-file": "version.txt",
      "extra-files": [
        {
          "type": "generic",
          "path": "kmp-app/iosApp/Configuration/Config.xcconfig"
        }
      ],
      "initial-version": "1.0.0",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "draft": true,
      "force-tag-creation": true,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "refactor",
          "section": "Refactoring"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "build",
          "section": "Build system"
        },
        {
          "type": "ci",
          "section": "Continuous integration"
        },
        {
          "type": "test",
          "section": "Tests"
        },
        {
          "type": "chore",
          "section": "Maintenance",
          "hidden": true
        }
      ]
    }
  }
}
